@model RealEstateRegalSpace.Models.Wallet
@{
    ViewBag.Title = "Advance Payment List";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .associate-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
    }
    .filter-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 24px;
        margin-bottom: 24px;
    }
    .form-control-modern {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        height: 44px !important;
        font-size: 0.925rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        padding: 8px 16px !important;
    }
    .form-label-modern {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        margin-bottom: 6px;
    }
    .btn-search-modern {
        background: #10b981 !important;
        border: none !important;
        border-radius: 10px !important;
        height: 44px !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
        color: #ffffff !important;
        padding: 0 28px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }
    .btn-search-modern:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
    .table-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }
    .table-modern {
        width: 100%;
        margin-bottom: 0;
    }
    .table-modern thead {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
    }
    .table-modern thead th {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #475569;
        padding: 14px 16px;
        border: none;
        white-space: nowrap;
    }
    .table-modern tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.15s ease;
    }
    .table-modern tbody tr:hover {
        background-color: #f8fafc;
    }
    .table-modern tbody td {
        padding: 14px 16px;
        font-size: 0.9rem;
        color: #334155;
        vertical-align: middle;
        white-space: nowrap;
    }
    .table-modern tfoot tr {
        background: #f8fafc;
        border-top: 2px solid #e2e8f0;
    }
    .table-modern tfoot th {
        padding: 14px 16px;
        font-size: 0.95rem;
        font-weight: 800;
        color: #1e293b;
    }
</style>

<div class="container-fluid pt-3">
    <h2 class="associate-page-title">Advance Payment List</h2>

    @using (Html.BeginForm("AdvancePaymentList", "Associate", FormMethod.Get, new { @id = "form1", enctype = "multipart/form-data" }))
    {
        <!-- Modern Filter Card -->
        <div class="filter-card">
            <div class="row align-items-end">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 mb-3 mb-lg-0">
                    <label class="form-label-modern">From Joining Date</label>
                    @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control form-control-modern", placeholder = "From Date" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 mb-3 mb-lg-0">
                    <label class="form-label-modern">To Joining Date</label>
                    @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control form-control-modern", placeholder = "To Date" })
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
                    <input type="submit" value="Get Details" class="btn btn-search-modern w-100" />
                </div>
            </div>
        </div>

        <!-- Modern Table Card -->
        <div class="table-card">
            <div class="table-responsive">
                @if (Model != null)
                {
                    decimal totalAmt = 0;
                    <table id="example23" class="table table-modern">
                        <thead>
                            <tr>
                                <th>Payment Date</th>
                                <th>Login ID</th>
                                <th>Name</th>
                                <th>Payment Mode</th>
                                <th>Bank Details</th>
                                <th>Description</th>
                                <th class="text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.advancePayment != null && Model.advancePayment.Rows.Count > 0)
                            {
                                for (int i = 0; i < Model.advancePayment.Rows.Count; i++)
                                {
                                    decimal rowAmt = 0;
                                    decimal.TryParse(Model.advancePayment.Rows[i]["Amount"].ToString(), out rowAmt);
                                    totalAmt += rowAmt;
                                    <tr>
                                        <td>@Model.advancePayment.Rows[i]["PaymentDate"].ToString()</td>
                                        <td><span class="badge badge-light border text-dark px-2 py-1">@Model.advancePayment.Rows[i]["LoginID"].ToString()</span></td>
                                        <td class="font-weight-bold text-dark">@Model.advancePayment.Rows[i]["FirstName"].ToString()</td>
                                        <td><span class="badge badge-info px-2 py-1">@Model.advancePayment.Rows[i]["PaymentMode"].ToString()</span></td>
                                        <td>@Model.advancePayment.Rows[i]["PayMode"].ToString()</td>
                                        <td class="text-muted">@Model.advancePayment.Rows[i]["Description"].ToString()</td>
                                        <td class="text-right font-weight-bold text-success">&#8377;@rowAmt.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted font-weight-bold">
                                        <i class="fas fa-info-circle mr-1 text-primary"></i> No advance payment records found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="6" class="text-right">Total Advance Amount:</th>
                                <th class="text-right text-success" style="font-size: 1.05rem;">&#8377;@totalAmt.ToString("N2")</th>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        </div>
    }
</div>

<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">
<script>
    $('#FromDate').datepicker({
        dateFormat: 'dd/mm/yy'
    });
    $('#ToDate').datepicker({
        dateFormat: 'dd/mm/yy'
    });
</script>
