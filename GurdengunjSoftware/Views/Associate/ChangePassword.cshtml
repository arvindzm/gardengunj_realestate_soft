@model RealEstateRegalSpace.Models.ChangePasswordClass

@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .associate-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
    }
    .modern-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 28px;
        margin-bottom: 24px;
        max-width: 800px;
    }
    .form-control-modern {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        height: 44px !important;
        font-size: 0.925rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        padding: 8px 16px !important;
    }
    .form-label-modern {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        margin-bottom: 6px;
    }
    .btn-save-modern {
        background: #10b981 !important;
        border: none !important;
        border-radius: 10px !important;
        height: 46px !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        color: #ffffff !important;
        padding: 0 32px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }
    .btn-save-modern:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
</style>

<div class="container-fluid pt-3">
    <h2 class="associate-page-title">Change Password</h2>

    @using (Html.BeginForm("ChangePassword", "Associate", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
    {
        <div class="modern-card">
            @if (TempData["Login"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-lg font-weight-bold" role="alert">
                    <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Login"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label-modern">Old Password <span class="text-danger">*</span></label>
                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control form-control-modern", @placeholder = "Enter Old Password" })
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label-modern">New Password <span class="text-danger">*</span></label>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control form-control-modern", @placeholder = "Enter New Password" })
                    <div class="mt-2 text-muted small font-weight-bold">
                        <input id="chkShowPassword" type="checkbox" onclick="ShowPassword(this)" /> Show Password
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label-modern">Confirm Password <span class="text-danger">*</span></label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control form-control-modern", @placeholder = "Confirm New Password" })
                    <div class="mt-2 text-muted small font-weight-bold">
                        <input id="chkShowPassword1" type="checkbox" onclick="ShowPasswordNew(this)" /> Show Password
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-save-modern" type="submit" onclick="return validateform();" id="btnchange" name="ChangePassword">
                    <i class="fas fa-key mr-2"></i>Change Password
                </button>
            </div>
        </div>
    }
</div>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script>
    function ShowPassword(chkShowPassword) {
        var txtPassword = document.getElementById("NewPassword");
        if (chkShowPassword.checked) {
            txtPassword.setAttribute('TYPE', 'TEXT');
        } else {
            txtPassword.setAttribute('TYPE', 'PASSWORD');
        }
    }
    function ShowPasswordNew(chkShowPassword) {
        var txtPassword = document.getElementById("ConfirmPassword");
        if (chkShowPassword.checked) {
            txtPassword.setAttribute('TYPE', 'TEXT');
        } else {
            txtPassword.setAttribute('TYPE', 'PASSWORD');
        }
    }
    function validateform() {
        if ($('#OldPassword').val() == '') {
            alert('Please enter Old Password');
            $('#OldPassword').focus();
            return false;
        }
        if ($('#NewPassword').val() == '') {
            alert('Please enter New Password');
            $('#NewPassword').focus();
            return false;
        }
        if ($('#ConfirmPassword').val() == '') {
            alert('Please enter Confirm Password');
            $('#ConfirmPassword').focus();
            return false;
        }
        if ($('#NewPassword').val() != $('#ConfirmPassword').val()) {
            alert('New Password and Confirm Password do not match');
            $('#ConfirmPassword').focus();
            return false;
        }
        return true;
    }
</script>
