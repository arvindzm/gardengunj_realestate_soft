@model RealEstateRegalSpace.Models.Wallet

@{
    ViewBag.Title = "Payout Request";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        @using (Html.BeginForm("PayoutRequest", "Associate", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
        {
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-wallet mr-2"></i>Payout Request</h5>
                </div>
                <div class="card-body p-4">
                    @if (TempData["PayoutReq"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-info-circle mr-2"></i>@TempData["PayoutReq"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded bg-light border">
                                <label class="text-muted small text-uppercase font-weight-bold d-block mb-1">Available Wallet Balance</label>
                                <h4 class="font-weight-bold text-success mb-0">Rs. @(ViewBag.Balance != null ? ViewBag.Balance : "0.00")</h4>
                            </div>
                        </div>

                        <div class="col-md-5 mb-3">
                            <div class="form-group mb-0">
                                <label class="font-weight-bold">Request Amount <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", @Placeholder = "Enter Amount", @onkeypress = "return isNumberOrDecimal(event);" })
                            </div>
                        </div>

                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <button type="submit" onclick="return validateform();" class="btn btn-success px-4 py-2 w-100" id="btnSave" name="Save">
                                <i class="fas fa-paper-plane mr-2"></i>Submit Request
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script>
    function validateform() {
        $(".errortext").removeClass("errortext");

        if ($('#Amount').val() == '' || parseFloat($('#Amount').val()) <= 0) {
            $("#Amount").addClass('errortext');
            $('#Amount').focus();
            return false;
        }
        return true;
    }

    function isNumberOrDecimal(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }
</script>
