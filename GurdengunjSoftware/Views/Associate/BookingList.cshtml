@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "Booking List";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .associate-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
    }
    .filter-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 24px;
        margin-bottom: 24px;
    }
    .form-control-modern {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        height: 44px !important;
        font-size: 0.925rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        padding: 8px 16px !important;
    }
    .form-label-modern {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        margin-bottom: 6px;
    }
    .btn-search-modern {
        background: #10b981 !important;
        border: none !important;
        border-radius: 10px !important;
        height: 44px !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
        color: #ffffff !important;
        padding: 0 28px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }
    .btn-search-modern:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
    .table-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }
    .table-modern {
        width: 100%;
        margin-bottom: 0;
    }
    .table-modern thead {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
    }
    .table-modern thead th {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #475569;
        padding: 14px 16px;
        border: none;
        white-space: nowrap;
    }
    .table-modern tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.15s ease;
    }
    .table-modern tbody tr:hover {
        background-color: #f8fafc;
    }
    .table-modern tbody td {
        padding: 14px 16px;
        font-size: 0.9rem;
        color: #334155;
        vertical-align: middle;
        white-space: nowrap;
    }
</style>

<div class="container-fluid pt-3">
    <h2 class="associate-page-title">Booking List</h2>

    @using (Html.BeginForm("BookingList", "Associate", FormMethod.Post, new { @id = "form1" }))
    {
        <!-- Modern Filter Card -->
        <div class="filter-card">
            <div class="row align-items-end">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Customer ID</label>
                    @Html.TextBoxFor(m => m.CustomerID, new { @class = "form-control form-control-modern", placeholder = "Search Customer ID" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">From Date</label>
                    @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control form-control-modern", placeholder = "From Date", @readonly = "readonly" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">To Date</label>
                    @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control form-control-modern", placeholder = "To Date", @readonly = "readonly" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Booking No</label>
                    @Html.TextBoxFor(m => m.BookingNumber, new { @class = "form-control form-control-modern", placeholder = "Booking No" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3 mb-lg-0">
                    <label class="form-label-modern">Select Site</label>
                    @Html.DropDownListFor(m => m.SiteID, (IEnumerable<SelectListItem>)ViewBag.ddlSite, new { @class = "form-control form-control-modern", @onchange = "return onSiteChange();" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3 mb-lg-0">
                    <label class="form-label-modern">Select Sector</label>
                    @Html.DropDownListFor(m => m.SectorID, (IEnumerable<SelectListItem>)ViewBag.ddlSector, new { @class = "form-control form-control-modern", @onchange = "return onSectorChange();" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3 mb-lg-0">
                    <label class="form-label-modern">Select Block</label>
                    @Html.DropDownListFor(m => m.BlockID, (IEnumerable<SelectListItem>)ViewBag.ddlBlock, new { @class = "form-control form-control-modern" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
                    <input class="btn btn-search-modern w-100" type="submit" value="Search" id="btnSearch" name="Search" />
                </div>
            </div>
        </div>

        <!-- Modern Table Card -->
        <div class="table-card">
            <div class="table-responsive">
                <table id="basic-btn" class="table table-modern">
                    <thead>
                        <tr>
                            <th>Sr No.</th>
                            <th>Booking No</th>
                            <th>Customer Name</th>
                            <th>Associate Name</th>
                            <th>Plot Details</th>
                            <th>Booking Date</th>
                            <th class="text-right">Booking Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.lstPlot != null && Model.lstPlot.Count > 0)
                        {
                            int j = 1;
                            foreach (var item in Model.lstPlot)
                            {
                                <tr>
                                    <td class="font-weight-bold text-muted">@j</td>
                                    <td><span class="badge badge-primary px-2 py-1">#@item.BookingNumber</span></td>
                                    <td class="font-weight-bold text-dark">@item.CustomerName (@item.CustomerCode)</td>
                                    <td>@item.AssociateName (@item.AssociateCode)</td>
                                    <td>
                                        <div class="font-weight-bold text-primary">@item.SiteName</div>
                                        <small class="text-muted">Sector: @item.SectorName | Block: @item.BlockName | Plot: @item.PlotNumber</small>
                                    </td>
                                    <td>@item.BookingDate</td>
                                    <td class="text-right font-weight-bold text-success">&#8377;@item.BookingAmount</td>
                                </tr>
                                j++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted font-weight-bold">
                                    <i class="fas fa-info-circle mr-1 text-primary"></i> No booking records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">
<script>
    $('#FromDate').datepicker({
        dateFormat: 'dd/mm/yy'
    });
    $('#ToDate').datepicker({
        dateFormat: 'dd/mm/yy'
    });

    function onSiteChange() {
        var siteId = $('#SiteID').val();
        $.ajax({
            url: '/Associate/GetSectorList',
            type: 'POST',
            data: { SiteID: siteId },
            success: function (data) {
                $('#SectorID').empty();
                $('#SectorID').append('<option value="">Select Sector</option>');
                $.each(data, function (i, item) {
                    $('#SectorID').append('<option value="' + item.Value + '">' + item.Text + '</option>');
                });
            }
        });
    }

    function onSectorChange() {
        var sectorId = $('#SectorID').val();
        $.ajax({
            url: '/Associate/GetBlockList',
            type: 'POST',
            data: { SectorID: sectorId },
            success: function (data) {
                $('#BlockID').empty();
                $('#BlockID').append('<option value="">Select Block</option>');
                $.each(data, function (i, item) {
                    $('#BlockID').append('<option value="' + item.Value + '">' + item.Text + '</option>');
                });
            }
        });
    }
</script>
