@model RealEstateRegalSpace.Models.KYCDocuments

@{
    ViewBag.Title = "KYC Documents";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .associate-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
    }
    .modern-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 28px;
        margin-bottom: 24px;
    }
    .form-control-modern {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        height: 44px !important;
        font-size: 0.925rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        padding: 8px 16px !important;
    }
    .form-label-modern {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        margin-bottom: 6px;
    }
    .btn-save-modern {
        background: #10b981 !important;
        border: none !important;
        border-radius: 10px !important;
        height: 46px !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        color: #ffffff !important;
        padding: 0 32px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }
    .btn-save-modern:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
    .section-subtitle {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 16px;
    }
</style>

<div class="container-fluid pt-3">
    <h2 class="associate-page-title">KYC Documents & Profile Details</h2>

    @using (Html.BeginForm("KYCDocuments", "Associate", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
    {
        <div class="modern-card">
            <!-- Personal Details -->
            <div class="section-subtitle text-primary">
                <i class="fas fa-user-circle mr-2"></i>Personal & Contact Information
            </div>
            <div class="row mb-3">
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">First Name</label>
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control form-control-modern", @placeholder = "First Name" })
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Last Name</label>
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control form-control-modern", @placeholder = "Last Name" })
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Mobile No</label>
                    @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control form-control-modern", @placeholder = "Mobile No", @readonly = "readonly" })
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Email Address</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-modern", @placeholder = "Email Address" })
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Father / Guardian Name</label>
                    @Html.TextBoxFor(m => m.FatherName, new { @class = "form-control form-control-modern", @placeholder = "Father's Name" })
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Relation</label>
                    @Html.DropDownListFor(m => m.Relation, new SelectList(ViewBag.ddlRelation ?? new List<SelectListItem>(), "Value", "Text"), new { @class = "form-control form-control-modern" })
                </div>
                <div class="col-md-12 mb-3">
                    <label class="form-label-modern">Address</label>
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control form-control-modern", @placeholder = "Full Address" })
                </div>
            </div>

            <hr class="my-4" />

            <!-- Bank Account Details -->
            <div class="section-subtitle text-primary">
                <i class="fas fa-university mr-2"></i>Bank Account Information
            </div>
            <div class="row mb-3">
                <div class="col-md-3 mb-3">
                    <label class="form-label-modern">Account Number</label>
                    @Html.TextBoxFor(m => m.AccountNo, new { @class = "form-control form-control-modern", @placeholder = "Account Number" })
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label-modern">Bank Name</label>
                    @Html.TextBoxFor(m => m.BankName, new { @class = "form-control form-control-modern", @placeholder = "Bank Name" })
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label-modern">Bank Branch</label>
                    @Html.TextBoxFor(m => m.BankBranch, new { @class = "form-control form-control-modern", @placeholder = "Bank Branch" })
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label-modern">IFSC Code</label>
                    @Html.TextBoxFor(m => m.IFSC, new { @class = "form-control form-control-modern", @placeholder = "IFSC Code" })
                </div>
            </div>

            <hr class="my-4" />

            <!-- Document Verification Numbers -->
            <div class="section-subtitle text-primary">
                <i class="fas fa-id-card mr-2"></i>Verification Numbers & Status
            </div>

            <div class="row mb-3">
                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Aadhaar Number <span class="text-danger">*</span></label>
                    @if (Model != null && Model.AdharStatus == "Approved")
                    {
                        @Html.TextBoxFor(m => m.AdharNumber, new { @class = "form-control form-control-modern", @required = "required", @maxlength = "12", @readonly = "readonly" })
                        <small class="form-text text-success font-weight-bold mt-1"><i class="fas fa-check-circle mr-1"></i>Approved</small>
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.AdharNumber, new { @class = "form-control form-control-modern", @required = "required", @maxlength = "12" })
                        <small class="form-text text-danger font-weight-bold mt-1">@(Model != null && !string.IsNullOrEmpty(Model.AdharStatus) ? Model.AdharStatus : "Pending Upload")</small>
                    }
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">PAN Number <span class="text-danger">*</span></label>
                    @if (Model != null && Model.PanStatus == "Approved")
                    {
                        @Html.TextBoxFor(m => m.PanNumber, new { @class = "form-control form-control-modern", @required = "required", @maxlength = "10", @readonly = "readonly" })
                        <small class="form-text text-success font-weight-bold mt-1"><i class="fas fa-check-circle mr-1"></i>Approved</small>
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.PanNumber, new { @class = "form-control form-control-modern", @required = "required", @maxlength = "10" })
                        <small class="form-text text-danger font-weight-bold mt-1">@(Model != null && !string.IsNullOrEmpty(Model.PanStatus) ? Model.PanStatus : "Pending Upload")</small>
                    }
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label-modern">Overall Document Status</label>
                    <div>
                        @if (Model != null && Model.DocumentStatus == "Approved")
                        {
                            <span class="badge badge-success px-3 py-2 font-weight-bold"><i class="fas fa-check-circle mr-1"></i>Approved</span>
                        }
                        else
                        {
                            <span class="badge badge-warning text-dark px-3 py-2 font-weight-bold"><i class="fas fa-clock mr-1"></i>@(Model != null && !string.IsNullOrEmpty(Model.DocumentStatus) ? Model.DocumentStatus : "Pending")</span>
                        }
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Document Uploads -->
            <div class="section-subtitle text-primary">
                <i class="fas fa-upload mr-2"></i>Upload Documents
            </div>

            <div class="row">
                <div class="col-md-4 mb-4">
                    <label class="form-label-modern">Aadhaar Front Image</label>
                    <input type="file" name="postedFileaadhar" class="form-control-file border rounded p-2 bg-light w-100" />
                    @if (Model != null && !string.IsNullOrEmpty(Model.AdharImage))
                    {
                        <div class="mt-2 text-center">
                            <img src="@Url.Content(Model.AdharImage)" class="img-thumbnail rounded" style="max-height: 120px; object-fit: contain;" alt="Aadhaar Front" />
                        </div>
                    }
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label-modern">PAN Card Image</label>
                    <input type="file" name="postedFilePan" class="form-control-file border rounded p-2 bg-light w-100" />
                    @if (Model != null && !string.IsNullOrEmpty(Model.PanImage))
                    {
                        <div class="mt-2 text-center">
                            <img src="@Url.Content(Model.PanImage)" class="img-thumbnail rounded" style="max-height: 120px; object-fit: contain;" alt="PAN Card" />
                        </div>
                    }
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label-modern">Aadhaar Back Image</label>
                    <input type="file" name="postedFileAadharBack" class="form-control-file border rounded p-2 bg-light w-100" />
                    @if (Model != null && !string.IsNullOrEmpty(Model.DocumentImage))
                    {
                        <div class="mt-2 text-center">
                            <img src="@Url.Content(Model.DocumentImage)" class="img-thumbnail rounded" style="max-height: 120px; object-fit: contain;" alt="Aadhaar Back" />
                        </div>
                    }
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label-modern">Profile Picture</label>
                    <input type="file" name="postedFileProfile" class="form-control-file border rounded p-2 bg-light w-100" />
                    @if (Model != null && !string.IsNullOrEmpty(Model.ProfilePic))
                    {
                        <div class="mt-2 text-center">
                            <img src="@Url.Content(Model.ProfilePic)" class="img-thumbnail rounded" style="max-height: 120px; object-fit: contain;" alt="Profile Picture" />
                        </div>
                    }
                </div>

                <div class="col-md-4 mb-4">
                    <label class="form-label-modern">Signature Image</label>
                    <input type="file" name="postedFileSignature" class="form-control-file border rounded p-2 bg-light w-100" />
                    @if (Model != null && !string.IsNullOrEmpty(Model.Signature))
                    {
                        <div class="mt-2 text-center">
                            <img src="@Url.Content(Model.Signature)" class="img-thumbnail rounded" style="max-height: 120px; object-fit: contain;" alt="Signature" />
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" id="btnUpdate" class="btn btn-save-modern" name="btnUpdate" value="Update">
                    <i class="fas fa-save mr-2"></i>Update KYC Documents
                </button>
            </div>
        </div>
    }
</div>
