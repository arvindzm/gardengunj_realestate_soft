@model RealEstateRegalSpace.Models.TraditionalAssociate

@{
    ViewBag.Title = "Associate Registration";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .associate-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
    }
    .modern-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 28px;
        margin-bottom: 24px;
    }
    .form-control-modern {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        height: 44px !important;
        font-size: 0.925rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        padding: 8px 16px !important;
    }
    .form-label-modern {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        margin-bottom: 6px;
    }
    .btn-save-modern {
        background: #10b981 !important;
        border: none !important;
        border-radius: 10px !important;
        height: 44px !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
        color: #ffffff !important;
        padding: 0 32px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }
    .btn-save-modern:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
</style>

<div class="container-fluid pt-3">
    <h2 class="associate-page-title">Associate Registration</h2>

    @using (Html.BeginForm("AssociateRegistration", "Associate", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
    {
        <div class="modern-card">
            @if (TempData["Registration"] != null || TempData["AssociateDetails"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-4 rounded-lg font-weight-bold" role="alert">
                    @TempData["Registration"]
                    @TempData["AssociateDetails"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <!-- 4 Column Form Grid Row 1 -->
            <div class="row mb-3">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Sponsor Code <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.sponserId, new { @class = "form-control form-control-modern", @Placeholder = "Sponsor ID", @readonly = "readonly" })
                    @Html.HiddenFor(m => m.UserID)
                    @Html.HiddenFor(m => m.Fk_UserId)
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Sponsor Name</label>
                    @Html.TextBoxFor(m => m.sponsorName, new { @class = "form-control form-control-modern", @Placeholder = "Sponsor Name", @readonly = "readonly" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Designation <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.DesignationID, new SelectList(ViewBag.ddlDesignation, "Value", "Text"), new { @class = "form-control form-control-modern", @onchange = "return onSiteChange();" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">First Name <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control form-control-modern", @Placeholder = "First Name" })
                </div>
            </div>

            <!-- 4 Column Form Grid Row 2 -->
            <div class="row mb-3">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Last Name</label>
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control form-control-modern", @Placeholder = "Last Name" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Mobile No <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Contact, new { @class = "form-control form-control-modern", @Placeholder = "Mobile Number", @onkeypress = "return isNumberOrDecimal(event);", @maxlength = "10" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Address <span class="text-danger">*</span></label>
                    @Html.TextAreaFor(m => m.Address, new { @class = "form-control form-control-modern", @Placeholder = "Address", style = "height: 44px; min-height: 44px;" })
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 mb-3">
                    <label class="form-label-modern">Aadhar No</label>
                    @Html.TextBoxFor(m => m.AdharNumber, new { @class = "form-control form-control-modern", @Placeholder = "AdharNumber", @maxlength = "12" })
                </div>
            </div>

            <div class="mt-3">
                @if (Model.UserID == null)
                {
                    <input class="btn btn-save-modern" type="submit" onclick="return validateform();" value="Save" id="btnSave" name="btnSave" />
                }
                else
                {
                    @Html.HiddenFor(m => m.UserID, new { @Value = @Model.UserID })
                    <input class="btn btn-save-modern" type="submit" onclick="return validateform();" value="Update" id="btnUpdate" name="btnUpdate" />
                }
            </div>
        </div>
    }
</div>

<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script>
    $(document).ready(function () {
        getSponsorName();
    });

    function GetDirectdata() {
        if ($('#CommissionType').val() == "Direct") {
            $("#directPerc").css({ 'display': '' });
            $('#sponserId').val('KDSL1234');
            getSponsorName();
        }
        else {
            $("#directPerc").css({ 'display': 'none' });
            $('#sponserId').val('');
        }
    }

    function getSponsorName() {
        var sponsorID = $('#sponserId').val();
        if (!sponsorID || sponsorID.trim() === '') {
            return;
        }
        $("#divload").css({ 'display': '' });
        $.ajax({
            url: '/Associate/GetSponsorName', type: 'post', dataType: 'json',
            data: { 'SponsorID': sponsorID },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                if (data.Result == "yes") {
                    $("#sponsorName").val(data.sponsorName);
                    $("#UserID").val(data.UserID);
                    $("#sponsorName").removeClass('errortext');
                    $("#sponserId").removeClass('errortext');

                    if (data.ddlDesignation && data.ddlDesignation.length > 0) {
                        $("#DesignationID").html("");
                        $("#DesignationID").empty();

                        $.each(data.ddlDesignation, function (index, Sectorcount) {
                            $("#DesignationID").append(
                                $('<option></option>').val(Sectorcount.Value).html(Sectorcount.Text));
                        });
                        $("#DesignationID").val(1);
                    }
                }
                else if (data.Result == "no") {
                    $("#sponsorName").val('');
                    $("#sponsorName").addClass('errortext');
                    $("#sponserId").addClass('errortext');
                }
            }
        });
    }

    function validateform() {
        $(".errortext").removeClass("errortext");

        if ($('#sponserId').val() == '') {
            $("#sponserId").addClass('errortext');
            $('#sponserId').focus();
            $('#sponserId').val('');
            return false;
        }
        if ($('#DesignationID').val() == '0') {
            $("#DesignationID").addClass('errortext');
            $('#DesignationID').focus();
            return false;
        }
        if ($('#FirstName').val() == '') {
            $("#FirstName").addClass('errortext');
            $('#FirstName').focus();
            return false;
        }
        if ($('#Contact').val() == '') {
            $("#Contact").addClass('errortext');
            $('#Contact').focus();
            return false;
        }
        $("#divload").css({ 'display': '' });
        return true;
    }

    function isNumberOrDecimal(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31 && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }
</script>
