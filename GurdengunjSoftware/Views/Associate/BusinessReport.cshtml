@model RealEstateRegalSpace.Models.Reports

@{
    ViewBag.Title = "Business Report";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .associate-page-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 1.5rem;
    }
    .filter-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 24px;
        margin-bottom: 24px;
    }
    .form-control-modern {
        border-radius: 10px !important;
        border: 1px solid #cbd5e1 !important;
        height: 44px !important;
        font-size: 0.925rem !important;
        font-weight: 500 !important;
        color: #1e293b !important;
        padding: 8px 16px !important;
    }
    .form-label-modern {
        font-weight: 600;
        font-size: 0.875rem;
        color: #475569;
        margin-bottom: 6px;
    }
    .btn-search-modern {
        background: #10b981 !important;
        border: none !important;
        border-radius: 10px !important;
        height: 44px !important;
        font-weight: 700 !important;
        font-size: 0.95rem !important;
        color: #ffffff !important;
        padding: 0 28px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }
    .btn-search-modern:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
    .table-card {
        background: #ffffff;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }
    .table-modern {
        width: 100%;
        margin-bottom: 0;
    }
    .table-modern thead {
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
    }
    .table-modern thead th {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #475569;
        padding: 14px 16px;
        border: none;
        white-space: nowrap;
    }
    .table-modern tbody tr {
        border-bottom: 1px solid #f1f5f9;
        transition: background-color 0.15s ease;
    }
    .table-modern tbody tr:hover {
        background-color: #f8fafc;
    }
    .table-modern tbody td {
        padding: 14px 16px;
        font-size: 0.9rem;
        color: #334155;
        vertical-align: middle;
        white-space: nowrap;
    }
</style>

<div class="container-fluid pt-3">
    <h2 class="associate-page-title">Business Reports</h2>

    @using (Html.BeginForm("BusinessReport", "Associate", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
    {
        <!-- Modern Filter Card -->
        <div class="filter-card">
            <div class="row align-items-end">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 mb-3 mb-lg-0">
                    <label class="form-label-modern">Select Month</label>
                    @Html.DropDownListFor(m => m.Month, new SelectList(ViewBag.ddlMonth, "Value", "Text"), new { @class = "form-control form-control-modern" })
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                    <input type="submit" id="btnSearch" class="btn btn-search-modern w-100" name="Search" value="Search" onclick="return fvalidate();" />
                </div>
            </div>
        </div>

        <!-- Modern Table Card -->
        <div class="table-card">
            <div class="table-responsive">
                <table id="example23" class="table table-modern">
                    <thead>
                        <tr>
                            <th>Sr No.</th>
                            <th>Login ID</th>
                            <th>Associate Name</th>
                            <th>Self Business</th>
                            <th>Team Business</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.lstDetails != null && Model.lstDetails.Rows.Count > 0)
                        {
                            int j = 1;
                            for (int i = 0; i < Model.lstDetails.Rows.Count; i++)
                            {
                                <tr>
                                    <td class="font-weight-bold text-muted">@j</td>
                                    <td><span class="badge badge-light border text-dark px-2 py-1">@Model.lstDetails.Rows[i]["LoginId"].ToString()</span></td>
                                    <td class="font-weight-bold text-dark">@Model.lstDetails.Rows[i]["Name"].ToString()</td>
                                    <td class="font-weight-bold text-success">&#8377;@Model.lstDetails.Rows[i]["SelfBusiness"].ToString()</td>
                                    <td class="font-weight-bold text-primary">&#8377;@Model.lstDetails.Rows[i]["TeamBusiness"].ToString()</td>
                                    <td class="text-right">
                                        <a class="btn btn-sm btn-outline-info font-weight-bold rounded-lg px-3" href="/Associate/BusinessReport?loginid=@Model.lstDetails.Rows[i]["LoginId"].ToString()">
                                            <i class="fas fa-sitemap mr-1"></i> Down Business
                                        </a>
                                    </td>
                                </tr>
                                j++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted font-weight-bold">
                                    <i class="fas fa-info-circle mr-1 text-primary"></i> No business details found for selected month.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    function fn_showPWD(id, pwd) {
        if ($('#' + id).html() != '******') {
            $('#' + id).html('******');
        } else {
            $('#' + id).html(pwd);
        }
    }
</script>
