@model RealEstateRegalSpace.Models.Dashboard

@{
    ViewBag.Title = "DashBoard";
    Layout = "~/Views/Shared/AdminLayout.cshtml";

    // Initialize Plot Stats Variables for global scope
    int available = 0, booked = 0, onHold = 0, registered = 0, cancelled = 0;
    var plotStatsTable = ViewBag.PlotStats as System.Data.DataTable;
    if (plotStatsTable != null)
    {
        foreach (System.Data.DataRow row in plotStatsTable.Rows)
        {
            available += plotStatsTable.Columns.Contains("AvailablePlots") ? Convert.ToInt32(row["AvailablePlots"]) : 0;
            booked += plotStatsTable.Columns.Contains("BookedPlots") ? Convert.ToInt32(row["BookedPlots"]) : 0;
            onHold += plotStatsTable.Columns.Contains("HoldPlots") ? Convert.ToInt32(row["HoldPlots"]) : 0;
            registered += plotStatsTable.Columns.Contains("RegisteredPlots") ? Convert.ToInt32(row["RegisteredPlots"]) : 0;
            cancelled += plotStatsTable.Columns.Contains("CancelledPlots") ? Convert.ToInt32(row["CancelledPlots"]) : 0;
        }
    }
}
<style>
    /* Modern Stat Cards */
    .stat-card {
        background: #fff;
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        overflow: hidden;
        min-height: 140px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 20px;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        text-decoration: none;
    }
    .stat-card-border-left {
        border-left: 6px solid var(--card-color);
    }
    .stat-card-border-bottom::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 20px;
        right: 20px;
        height: 3px;
        background: var(--card-color);
        border-radius: 3px 3px 0 0;
    }
    .stat-card-title {
        color: #6c757d;
        font-size: 0.85rem;
        font-weight: 500;
        margin-top: 5px;
        margin-bottom: 0;
    }
    .stat-card-value {
       color: #212529;
    font-size: clamp(1.1rem, 1.5vw, 1.5rem);
    font-weight: 800;
    margin-bottom: 0;
    line-height: 1.2;
    /* padding-right: 70px; */
    word-break: break-word;
    margin-top: 15px;
    }
    .stat-badge {
        position: absolute;
        top: 15px;
        right: 12px;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .badge-soft-success { background: #e6f4ea; color: #1e8e3e; }
    .badge-soft-danger { background: #fce8e6; color: #d93025; }
    .badge-soft-secondary { background: #f1f3f4; color: #5f6368; }
    
    .stat-card-footer {
        text-align: right;
        font-size: 0.85rem;
        font-weight: 500;
        margin-top: 15px;
    }
    .card {
    background: var(--card-bg);
    border: none !important;
    border-radius: var(--border-radius) !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04) !important;
    padding: 0px !important;
    margin-bottom: 30px !important;
    transition: var(--transition);
    height: 100%;
}
.table-responsive {
    background: #fff !important;
    border-radius: var(--border-radius);
    padding: 9px !important;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02) !important;
    margin-top: 20px;
    margin-bottom: 20px;
    overflow-x: scroll !important;
    overflow-y: hidden !important;
    display: block !important;
    width: 100% !important;
    scrollbar-width: auto;
    scrollbar-color: #004191 #f8fafc;
}
.card-body, .card-block {
    background: transparent !important;
    padding: 0px !important;
    margin: 0 !important;
    box-shadow: none !important;
}
.table tbody td {
    padding: 10px 15px !important;
    vertical-align: middle !important;
    color: #2d3748 !important;
    border-bottom: 1px solid #edf2f7 !important;
    font-size: 0.9rem !important;
}
    .status-row {
        transition: background 0.2s ease;
        padding: 5px;
        border-radius: 8px;
    }
    .status-row:hover {
        background: #f8f9fa;
        text-decoration: none !important;
    }
    .action-box:hover div {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    
    /* Chart Styles */
    canvas {
        width: 100% !important;
        height: 100% !important;
    }
    .badge-soft-primary { background: #eef2ff; color: #4f46e5; }
    .badge-soft-warning { background: #fff7ed; color: #ea580c; }
    .badge-soft-success { background: #f0fdf4; color: #16a34a; }
    .badge-soft-danger { background: #fef2f2; color: #dc2626; }
    .badge-soft-secondary { background: #f1f3f4; color: #5f6368; }
    .badge-soft-info { background: #e0f2fe; color: #0284c7; }
    
    .avatar-xs {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
    .text-nowrap { white-space: nowrap; }
    .card-header-premium {
        background: linear-gradient(45deg, #e87e1a, #f39c12);
        color: white;
        padding: 15px 20px;
        border-radius: 12px 12px 0 0;
        font-weight: 600;
    }
    .card-header-premium.secondary {
        background: linear-gradient(45deg, #6eb544, #8bc34a);
    }
    /* Tighten Spacing for Dashboard */
    .dashboard-row {
        margin-right: -8px !important;
        margin-left: -8px !important;
    }
    .dashboard-row > [class*="col-"] {
        padding-right: 8px !important;
        padding-left: 8px !important;
        margin-bottom: 16px !important; /* Uniform bottom gap */
    }
    .stat-card {
        padding: 18px !important;
        min-height: 130px !important;
    }
    .card {
        margin-bottom: 0 !important; /* Let column handle bottom margin */
        padding: 20px !important;
    }
    .page-body {
        margin-top: 15px !important;
    }
    .page-title-box {
        margin-bottom: 10px !important;
    }
</style>

<div class="wrapper">
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-8">
                    <h2 class="font-weight-bold mb-0" style="color: #2c3e50; font-size: 1.8rem;">Dashboard Overview</h2>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">
                        @{
                            string welcomeName = Session["FullName"] != null ? Session["FullName"].ToString() : "Admin";
                            if (welcomeName.Contains("Regal Space")) {
                                welcomeName = welcomeName.Replace("Regal Space", "Gardenestate Ventures");
                                welcomeName = welcomeName.Replace("Shashikala", "Gardenestate Ventures");
                            }
                        }
                        Welcome back, @welcomeName &middot; 
                        <span style="color: #6c757d;"><i class="far fa-calendar-alt mr-1" style="color: #e87e1a;"></i> Last updated: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </p>
                </div>
                <div class="col-sm-4 text-sm-right mt-3 mt-sm-0">
                    <a href="/Home/PlotAvailbility" target="_blank" class="btn btn-success shadow-sm font-weight-bold px-3 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #10b981, #059669); color: white;">
                        <i class="fas fa-th-large mr-1"></i> Plot Availability
                    </a>
                </div>
            </div>
        </div>
        <div class="page-body" style="margin-top: 25px;">
            @if (Session["Pk_AdminId"].ToString() == "11")
            {

            }
            else
            {
                <!-- Top KPI Row 1 -->
                <div class="row dashboard-row">
                    <!-- Total Associates -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Admin/AssociateList" class="stat-card stat-card-border-left" style="--card-color: #6eb544;">
                            <div>
                                <h3 class="stat-card-value">@ViewBag.TotalAssociate</h3>
                                <p class="stat-card-title">Total Associates</p>
                            </div>
                            <span class="stat-badge badge-soft-success">+@(ViewBag.AssociatePercentage ?? 0)%</span>
                            <div class="stat-card-footer text-primary">
                                +@(ViewBag.AssociateThisMonth ?? 0) this month
                            </div>
                        </a>
                    </div>

                    <!-- Total Customers -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Admin/CustomerList" class="stat-card stat-card-border-left" style="--card-color: #e87e1a;">
                            <div>
                                <h3 class="stat-card-value">@ViewBag.TotalCustomer</h3>
                                <p class="stat-card-title">Total Customers</p>
                            </div>
                            <span class="stat-badge badge-soft-success">+@(ViewBag.CustomerPercentage ?? 0)%</span>
                            <div class="stat-card-footer text-success">
                                +@(ViewBag.CustomerThisWeek ?? 0) this week
                            </div>
                        </a>
                    </div>

                    <!-- Total Bookings -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Admin/BookingList" class="stat-card stat-card-border-left" style="--card-color: #6eb544;">
                            <div>
                                <h3 class="stat-card-value">@ViewBag.TotalBooking</h3>
                                <p class="stat-card-title">Total Bookings</p>
                            </div>
                            <span class="stat-badge badge-soft-secondary">@(ViewBag.BookingPercentage ?? 0)%</span>
                            <div class="stat-card-footer text-warning">
                                Active booking
                            </div>
                        </a>
                    </div>

                    <!-- Total Active Associates -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Admin/AssociateList?status=P" class="stat-card stat-card-border-left" style="--card-color: #e87e1a;">
                            <div>
                                <h3 class="stat-card-value">@ViewBag.TotalActiveAssociate</h3>
                                <p class="stat-card-title">Total Active Associates</p>
                            </div>
                            <span class="stat-badge badge-soft-danger">-@(ViewBag.TotalInactiveAssociate ?? "0")</span>
                            <div class="stat-card-footer text-purple" style="color: #6f42c1;">
                                @ViewBag.TotalInactiveAssociate inactive
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Top KPI Row 2 -->
                <div class="row dashboard-row">
                    @if (Session["RoleName"].ToString() == "Admin" || Session["Pk_adminId"].ToString() == "9")
                    {
                        <!-- Direct Business -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/CollectionReport" class="stat-card stat-card-border-bottom" style="--card-color: #6eb544;">
                                <div>
                                    <h3 class="stat-card-value">&#8377;@(string.IsNullOrEmpty(Convert.ToString(ViewBag.TotalDirectBusiness)) ? "0.00" : ViewBag.TotalDirectBusiness)</h3>
                                    <p class="stat-card-title">Direct Business</p>
                                </div>
                                <span class="stat-badge text-success bg-transparent p-0" style="font-weight: 500;">Self-referred</span>
                            </a>
                        </div>
                    }

                    @if (Session["RoleName"].ToString() == "Admin" || Session["Pk_adminId"].ToString() == "9")
                    {
                        <!-- Level Business -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/CollectionReport" class="stat-card stat-card-border-bottom" style="--card-color: #e87e1a;">
                                <div>
                                    <h3 class="stat-card-value">&#8377;@(string.IsNullOrEmpty(Convert.ToString(ViewBag.TotalLevelBusienss)) ? "0.00" : ViewBag.TotalLevelBusienss)</h3>
                                    <p class="stat-card-title">Level Business</p>
                                </div>
                                <span class="stat-badge text-warning bg-transparent p-0" style="font-weight: 500; color: #fd7e14 !important;">Network income</span>
                            </a>
                        </div>
                    }

                    @if (Session["RoleName"].ToString() == "Admin")
                    {
                        <!-- Total Business -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/CollectionReport" class="stat-card stat-card-border-bottom" style="--card-color: #6610f2;">
                                <div>
                                    <h3 class="stat-card-value">&#8377;@(string.IsNullOrEmpty(Convert.ToString(ViewBag.TotalBusiness)) ? "0.00" : ViewBag.TotalBusiness)</h3>
                                    <p class="stat-card-title">Total Business</p>
                                </div>
                                <span class="stat-badge badge-soft-primary" style="font-weight: 500;">Overall</span>
                            </a>
                        </div>

                        <!-- Booked Area -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/GetPlotAreaReport?Status=Booked" class="stat-card stat-card-border-bottom" style="--card-color: #6eb544;">
                                <div>
                                    <h3 class="stat-card-value">@ViewBag.BookedArea <span style="font-size: 1rem; color: #6c757d; font-weight: 600;">Sq.ft.</span></h3>
                                    <p class="stat-card-title">Booked Area</p>
                                </div>
                                <span class="stat-badge badge-soft-success">Booked</span>
                            </a>
                        </div>
                    }
                </div>

                <!-- Top KPI Row 3 -->
                <div class="row dashboard-row">
                    <!-- Inactive Associate -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Admin/AssociateList?status=T" class="stat-card stat-card-border-bottom" style="--card-color: #dc3545;">
                            <div>
                                <h3 class="stat-card-value">@ViewBag.TotalInactiveAssociate</h3>
                                <p class="stat-card-title">Inactive Associates</p>
                            </div>
                            <span class="stat-badge text-danger bg-transparent p-0" style="font-weight: 500;">Action required</span>
                        </a>
                    </div>

                    @if (Session["RoleName"].ToString() == "Admin")
                    {
                        <!-- Pending Document -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/ApproveKYC" class="stat-card stat-card-border-bottom" style="--card-color: #ffc107;">
                                <div>
                                    <h3 class="stat-card-value">@ViewBag.PendingDocument</h3>
                                    <p class="stat-card-title">Pending Documents</p>
                                </div>
                                <span class="stat-badge badge-soft-danger">Pending</span>
                            </a>
                        </div>

                        <!-- Alloted Area -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/GetPlotAreaReport?Status=Alloted" class="stat-card stat-card-border-bottom" style="--card-color: #20c997;">
                                <div>
                                    <h3 class="stat-card-value">@ViewBag.AllotedArea <span style="font-size: 1rem; color: #6c757d; font-weight: 600;">Sq.ft.</span></h3>
                                    <p class="stat-card-title">Alloted Area</p>
                                </div>
                                <span class="stat-badge badge-soft-success">Alloted</span>
                            </a>
                        </div>

                        <!-- Registered Area -->
                        <div class="col-xl-3 col-md-6 mb-4">
                            <a href="/Admin/GetPlotAreaReport?Status=Registered" class="stat-card stat-card-border-bottom" style="--card-color: #6610f2;">
                                <div>
                                    <h3 class="stat-card-value">@ViewBag.RegisteredArea <span style="font-size: 1rem; color: #6c757d; font-weight: 600;">Sq.ft.</span></h3>
                                    <p class="stat-card-title">Registered Area</p>
                                </div>
                                <span class="stat-badge badge-soft-secondary">Registered</span>
                            </a>
                        </div>
                    }
                </div>

                <!-- Plot Status & Recent Bookings -->
                <div class="row dashboard-row">
                    <!-- Plot Status Overview -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                            <div class="card-body p-4">
                                 @{
                                    if (ViewBag.ddlSite == null)
                                    {
                                        RealEstateRegalSpace.Models.Master objM = new RealEstateRegalSpace.Models.Master();
                                        System.Data.DataSet dsSite = objM.GetSiteList();
                                        List<SelectListItem> ddlSite = new List<SelectListItem>();
                                        ddlSite.Add(new SelectListItem { Text = "All Sites", Value = "" });
                                        if (dsSite != null && dsSite.Tables.Count > 0)
                                        {
                                            foreach (System.Data.DataRow r in dsSite.Tables[0].Rows)
                                            {
                                                ddlSite.Add(new SelectListItem { Text = r["SiteName"].ToString(), Value = r["PK_SiteID"].ToString() });
                                            }
                                        }
                                        ViewBag.ddlSite = ddlSite;
                                    }
                                }
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="mb-0 font-weight-bold" style="color: #1e293b; font-size: 1.25rem;">Plot Status Overview</h5>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle font-weight-bold px-3 py-1" type="button" id="siteDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="border-radius: 8px; font-size: 0.85rem;">
                                            <span id="selected-site-name">
                                                @{
                                                    string siteName = "All Sites";
                                                    if (ViewBag.SiteID != null && ViewBag.ddlSite != null)
                                                    {
                                                        var selectedSite = ((List<SelectListItem>)ViewBag.ddlSite).FirstOrDefault(x => x.Value == ViewBag.SiteID.ToString());
                                                        if (selectedSite != null)
                                                        {
                                                            siteName = selectedSite.Text;
                                                        }
                                                    }
                                                }
                                                @siteName
                                            </span>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="siteDropdown">
                                            @if (ViewBag.ddlSite != null)
                                            {
                                                foreach (var site in (List<SelectListItem>)ViewBag.ddlSite)
                                                {
                                                    <a class="dropdown-item site-link @(ViewBag.SiteID != null && ViewBag.SiteID.ToString() == site.Value ? "active" : "")" href="javascript:void(0);" data-siteid="@site.Value" data-sitename="@site.Text">@site.Text</a>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                @{
                                    int totalPlots = available + booked + onHold + registered + cancelled;
                                    if (totalPlots == 0) { totalPlots = 1; } // Prevent div by zero
                                }

                                <div class="row align-items-center">
                                    <div class="col-md-5 mb-3 mb-md-0">
                                        <div style="height: 210px;">
                                            <canvas id="plotStatusChart"></canvas>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <!-- Available -->
                                        <a href="/Admin/PlotList?Status=A&SiteID=@ViewBag.SiteID" id="link-available" class="d-flex align-items-center mb-3 text-decoration-none status-row p-2 rounded-lg" style="transition: background 0.15s ease;">
                                            <div style="width: 85px;">
                                                <span class="font-weight-bold text-muted small">Available</span>
                                            </div>
                                            <div class="text-right pr-2" style="width: 50px;">
                                                <span class="font-weight-bold text-dark" id="count-available" style="font-size: 0.95rem;">@available</span>
                                            </div>
                                            <div class="flex-grow-1 mx-2">
                                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: #f1f5f9;">
                                                    <div class="progress-bar" id="progress-available" role="progressbar" style="width: @((available * 100) / totalPlots)%; background-color: #10b981; border-radius: 10px;"></div>
                                                </div>
                                            </div>
                                            <div style="width: 45px;" class="text-right pl-2">
                                                <span class="font-weight-bold text-muted small" id="percent-available">@((available * 100) / totalPlots)%</span>
                                            </div>
                                        </a>

                                        <!-- Booked -->
                                        <a href="/Admin/PlotList?Status=B&SiteID=@ViewBag.SiteID" id="link-booked" class="d-flex align-items-center mb-3 text-decoration-none status-row p-2 rounded-lg" style="transition: background 0.15s ease;">
                                            <div style="width: 85px;">
                                                <span class="font-weight-bold text-muted small">Booked</span>
                                            </div>
                                            <div class="text-right pr-2" style="width: 50px;">
                                                <span class="font-weight-bold text-dark" id="count-booked" style="font-size: 0.95rem;">@booked</span>
                                            </div>
                                            <div class="flex-grow-1 mx-2">
                                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: #f1f5f9;">
                                                    <div class="progress-bar" id="progress-booked" role="progressbar" style="width: @((booked * 100) / totalPlots)%; background-color: #3b82f6; border-radius: 10px;"></div>
                                                </div>
                                            </div>
                                            <div style="width: 45px;" class="text-right pl-2">
                                                <span class="font-weight-bold text-muted small" id="percent-booked">@((booked * 100) / totalPlots)%</span>
                                            </div>
                                        </a>

                                        <!-- On Hold -->
                                        <a href="/Admin/PlotList?Status=H&SiteID=@ViewBag.SiteID" id="link-onhold" class="d-flex align-items-center mb-3 text-decoration-none status-row p-2 rounded-lg" style="transition: background 0.15s ease;">
                                            <div style="width: 85px;">
                                                <span class="font-weight-bold text-muted small">On Hold</span>
                                            </div>
                                            <div class="text-right pr-2" style="width: 50px;">
                                                <span class="font-weight-bold text-dark" id="count-onhold" style="font-size: 0.95rem;">@onHold</span>
                                            </div>
                                            <div class="flex-grow-1 mx-2">
                                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: #f1f5f9;">
                                                    <div class="progress-bar" id="progress-onhold" role="progressbar" style="width: @((onHold * 100) / totalPlots)%; background-color: #f59e0b; border-radius: 10px;"></div>
                                                </div>
                                            </div>
                                            <div style="width: 45px;" class="text-right pl-2">
                                                <span class="font-weight-bold text-muted small" id="percent-onhold">@((onHold * 100) / totalPlots)%</span>
                                            </div>
                                        </a>

                                        <!-- Registered -->
                                        <a href="/Admin/PlotList?Status=R&SiteID=@ViewBag.SiteID" id="link-registered" class="d-flex align-items-center mb-3 text-decoration-none status-row p-2 rounded-lg" style="transition: background 0.15s ease;">
                                            <div style="width: 85px;">
                                                <span class="font-weight-bold text-muted small">Registered</span>
                                            </div>
                                            <div class="text-right pr-2" style="width: 50px;">
                                                <span class="font-weight-bold text-dark" id="count-registered" style="font-size: 0.95rem;">@registered</span>
                                            </div>
                                            <div class="flex-grow-1 mx-2">
                                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: #f1f5f9;">
                                                    <div class="progress-bar" id="progress-registered" role="progressbar" style="width: @((registered * 100) / totalPlots)%; background-color: #8b5cf6; border-radius: 10px;"></div>
                                                </div>
                                            </div>
                                            <div style="width: 45px;" class="text-right pl-2">
                                                <span class="font-weight-bold text-muted small" id="percent-registered">@((registered * 100) / totalPlots)%</span>
                                            </div>
                                        </a>

                                        <!-- Cancelled -->
                                        <a href="/Admin/PlotList?Status=C&SiteID=@ViewBag.SiteID" id="link-cancelled" class="d-flex align-items-center mb-0 text-decoration-none status-row p-2 rounded-lg" style="transition: background 0.15s ease;">
                                            <div style="width: 85px;">
                                                <span class="font-weight-bold text-muted small">Cancelled</span>
                                            </div>
                                            <div class="text-right pr-2" style="width: 50px;">
                                                <span class="font-weight-bold text-dark" id="count-cancelled" style="font-size: 0.95rem;">@cancelled</span>
                                            </div>
                                            <div class="flex-grow-1 mx-2">
                                                <div class="progress" style="height: 8px; border-radius: 10px; background-color: #f1f5f9;">
                                                    <div class="progress-bar" id="progress-cancelled" role="progressbar" style="width: @((cancelled * 100) / totalPlots)%; background-color: #ef4444; border-radius: 10px;"></div>
                                                </div>
                                            </div>
                                            <div style="width: 45px;" class="text-right pl-2">
                                                <span class="font-weight-bold text-muted small" id="percent-cancelled">@((cancelled * 100) / totalPlots)%</span>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Bookings -->
                    <div class="col-lg-6">
                        <div class="card shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="mb-0 font-weight-bold" style="color: #1e293b; font-size: 1.25rem;">Recent Bookings</h5>
                                    <a href="/Admin/BookingList" class="text-primary small font-weight-bold">View All <i class="fas fa-arrow-right ml-1"></i></a>
                                </div>
                                <div class="table-responsive p-0">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                                                <th class="py-3 pl-3 font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">CUSTOMER</th>
                                                <th class="py-3 text-center font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">PLOT</th>
                                                <th class="py-3 text-right font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">AMOUNT</th>
                                                <th class="py-3 text-right pr-3 font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">STATUS</th>
                                            </tr>
                                        </thead>
                                        <tbody class="font-weight-bold">
                                            @{
                                                var recent = ViewBag.RecentBookings as System.Data.DataTable;
                                                if (recent != null && recent.Rows.Count > 0) {
                                                    int count = 0;
                                                    foreach (System.Data.DataRow row in recent.Rows) {
                                                        if (count >= 5) { break; }
                                                        
                                                        string cName = "N/A";
                                                        if (recent.Columns.Contains("CustomerName")) { cName = row["CustomerName"].ToString(); }
                                                        else if (recent.Columns.Contains("Name")) { cName = row["Name"].ToString(); }
                                                        
                                                        string pNo = "N/A";
                                                        if (recent.Columns.Contains("PlotNumber")) { pNo = row["PlotNumber"].ToString(); }
                                                        else if (recent.Columns.Contains("PlotNo")) { pNo = row["PlotNo"].ToString(); }
                                                        
                                                        string amt = "0.00";
                                                        if (recent.Columns.Contains("NetPlotAmount")) { amt = Convert.ToDecimal(row["NetPlotAmount"]).ToString("N2"); }
                                                        else if (recent.Columns.Contains("BookingAmount")) { amt = Convert.ToDecimal(row["BookingAmount"]).ToString("N2"); }
                                                        else if (recent.Columns.Contains("PaidAmount")) { amt = Convert.ToDecimal(row["PaidAmount"]).ToString("N2"); }
                                                        else if (recent.Columns.Contains("Amount")) { amt = Convert.ToDecimal(row["Amount"]).ToString("N2"); }

                                                        string status = "Success";
                                                        if (recent.Columns.Contains("BookingStatus")) { status = row["BookingStatus"].ToString(); }
                                                        string badgeClass = status == "Approved" || status == "Registered" || status == "Success" ? "badge-soft-success" : (status == "Booked" ? "badge-soft-primary" : "badge-soft-warning");
                                                        
                                                        <tr style="border-bottom: 1px solid #f1f5f9;">
                                                            <td class="py-3 pl-3 font-weight-bold text-dark">@cName</td>
                                                            <td class="py-3 text-center"><span class="badge badge-light border text-dark font-weight-bold px-2 py-1">@pNo</span></td>
                                                            <td class="py-3 text-right text-dark">Rs. @amt</td>
                                                            <td class="py-3 text-right pr-3">
                                                                <span class="badge badge-pill @badgeClass px-3 py-1 font-weight-bold">@status</span>
                                                            </td>
                                                        </tr>
                                                        count++;
                                                    }
                                                } else {
                                                    <tr><td colspan="4" class="text-center py-4 text-muted">No recent bookings found</td></tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Business Analytics Row -->
                <div class="row dashboard-row">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="mb-0 font-weight-bold" style="color: #1e293b; font-size: 1.25rem;">Business Growth & Trends</h5>
                                    <div class="small text-muted font-weight-bold">Current Month Data</div>
                                </div>
                                <div style="height: 300px;">
                                    <canvas id="businessTrendChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                            <div class="card-body p-4">
                                <h5 class="mb-4 font-weight-bold" style="color: #1e293b; font-size: 1.25rem;">Business Mix</h5>
                                <div style="height: 250px;">
                                    <canvas id="businessMixChart"></canvas>
                                </div>
                                <div class="mt-4">
                                     <div class="d-flex justify-content-between mb-2">
                                        <span class="small font-weight-bold text-muted"><i class="fas fa-circle mr-2" style="color: #10b981;"></i> Direct Business</span>
                                        <span class="small font-weight-bold text-dark">&#8377;@(string.IsNullOrEmpty(Convert.ToString(ViewBag.TotalDirectBusiness)) ? "0.00" : ViewBag.TotalDirectBusiness)</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="small font-weight-bold text-muted"><i class="fas fa-circle mr-2" style="color: #f59e0b;"></i> Level Business</span>
                                        <span class="small font-weight-bold text-dark">&#8377;@(string.IsNullOrEmpty(Convert.ToString(ViewBag.TotalLevelBusienss)) ? "0.00" : ViewBag.TotalLevelBusienss)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- Pending Actions & Top Performers -->
                <div class="row dashboard-row">
                    <!-- Pending Actions -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                            <div class="card-body p-4">
                                <h5 class="mb-4 font-weight-bold" style="color: #1e293b; font-size: 1.25rem;">Pending Actions</h5>
                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <a href="/Admin/ApproveKYC" class="text-decoration-none d-block action-box">
                                            <div class="p-3 text-center" style="background: #eef2ff; border-radius: 14px; transition: transform 0.2s, box-shadow 0.2s;">
                                                <h3 class="mb-1 font-weight-bold" style="color: #4f46e5; font-size: 1.85rem;">@ViewBag.PendingDocument</h3>
                                                <p class="mb-0 font-weight-bold" style="color: #475569; font-size: 0.85rem;">Pending Documents</p>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <a href="/Admin/DueInstallmentReport" class="text-decoration-none d-block action-box">
                                            <div class="p-3 text-center" style="background: #fff7ed; border-radius: 14px; transition: transform 0.2s, box-shadow 0.2s;">
                                                <h3 class="mb-1 font-weight-bold" style="color: #ea580c; font-size: 1.85rem;">0</h3>
                                                <p class="mb-0 font-weight-bold" style="color: #475569; font-size: 0.85rem;">EMI Due Today</p>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="/Admin/ApprovePayent" class="text-decoration-none d-block action-box">
                                            <div class="p-3 text-center" style="background: #f0fdf4; border-radius: 14px; transition: transform 0.2s, box-shadow 0.2s;">
                                                <h3 class="mb-1 font-weight-bold" style="color: #16a34a; font-size: 1.85rem;">0</h3>
                                                <p class="mb-0 font-weight-bold" style="color: #475569; font-size: 0.85rem;">Approve Payments</p>
                                            </div>
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="/Admin/HoldList" class="text-decoration-none d-block action-box">
                                            <div class="p-3 text-center" style="background: #fef2f2; border-radius: 14px; transition: transform 0.2s, box-shadow 0.2s;">
                                                <h3 class="mb-1 font-weight-bold" style="color: #dc2626; font-size: 1.85rem;">0</h3>
                                                <p class="mb-0 font-weight-bold" style="color: #475569; font-size: 0.85rem;">Expiring Holds</p>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Associate Health & Top Performers -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm border-0" style="border-radius: 16px; background: #ffffff;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="mb-0 font-weight-bold" style="color: #1e293b; font-size: 1.25rem;">Associate Performance</h5>
                                    <a href="/Admin/AssociateList" class="small text-primary font-weight-bold">View All <i class="fas fa-arrow-right ml-1"></i></a>
                                </div>
                                
                                <div class="table-responsive p-0">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead>
                                            <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                                                <th class="py-3 pl-3 font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">ASSOCIATE</th>
                                                <th class="py-3 text-center font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">DESIGNATION</th>
                                                <th class="py-3 text-right pr-3 font-weight-bold uppercase" style="color: #475569; font-size: 0.75rem; letter-spacing: 0.5px;">STATUS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var performers = ViewBag.TopPerformers as System.Data.DataTable;
                                                if (performers != null && performers.Rows.Count > 0) {
                                                    int pCount = 0;
                                                    foreach (System.Data.DataRow row in performers.Rows) {
                                                        if (pCount >= 5) { break; }
                                                        
                                                        string assocName = performers.Columns.Contains("AssociateName") ? row["AssociateName"].ToString() : (performers.Columns.Contains("Name") ? row["Name"].ToString() : "N/A");
                                                        if (assocName.Contains("Regal Space")) {
                                                            assocName = assocName.Replace("Regal Space", "Gardenestate Ventures");
                                                            assocName = assocName.Replace("Shashikala", "Gardenestate Ventures");
                                                        }
                                                        
                                                        string desig = performers.Columns.Contains("Designation") ? row["Designation"].ToString() : (performers.Columns.Contains("DesignationName") ? row["DesignationName"].ToString() : (performers.Columns.Contains("FK_DesignationID") ? row["FK_DesignationID"].ToString() : "N/A"));
                                                        string status = performers.Columns.Contains("Status") ? row["Status"].ToString() : "Active";
                                                        string badgeClass = status == "Active" || status == "P" || status == "Approved" ? "badge-soft-success" : "badge-soft-warning";

                                                        string assocId = performers.Columns.Contains("AssociateId") ? row["AssociateId"].ToString() : (performers.Columns.Contains("LoginID") ? row["LoginID"].ToString() : (performers.Columns.Contains("LoginId") ? row["LoginId"].ToString() : "N/A"));
                                                        
                                                        <tr style="border-bottom: 1px solid #f1f5f9;">
                                                            <td class="py-3 pl-3">
                                                                <div class="d-flex align-items-center">
                                                                    <div class="avatar-xs mr-2 rounded-circle d-flex align-items-center justify-content-center font-weight-bold" style="width: 32px; height: 32px; background: #e0f2fe; color: #0284c7; font-size: 0.85rem;">
                                                                        @assocName.Substring(0, 1)
                                                                    </div>
                                                                    <div>
                                                                        <div class="font-weight-bold text-dark" style="font-size: 0.9rem;">@assocName</div>
                                                                        <div class="small text-muted">ID: @assocId</div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="py-3 text-center"><span class="badge badge-light border text-dark font-weight-bold px-2 py-1">@desig</span></td>
                                                            <td class="py-3 text-right pr-3">
                                                                <span class="badge badge-pill @badgeClass px-3 py-1 font-weight-bold">@status</span>
                                                            </td>
                                                        </tr>
                                                        pCount++;
                                                    }
                                                } else {
                                                    <tr><td colspan="3" class="text-center py-4 text-muted">No associate data available</td></tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Associate Business Performance -->
                <div class="row dashboard-row">
                    <div class="col-12">
                        <div class="card shadow-sm border-0" style="border-radius: 15px;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="mb-0 font-weight-bold" style="color: #444;">Associate Business Performance</h5>
                                    <div class="small text-muted">Business done by top performing associates</div>
                                </div>
                                <div style="height: 350px;">
                                    <canvas id="associateBusinessFullChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    $(document).ready(function () {
        // --- Charts Initialization ---
        var plotCtx = document.getElementById('plotStatusChart').getContext('2d');
        var plotChart = new Chart(plotCtx, {
            type: 'doughnut',
            data: {
                labels: ['Available', 'Booked', 'Hold', 'Registered', 'Cancelled'],
                datasets: [{
                    data: [@available, @booked, @onHold, @registered, @cancelled],
                    backgroundColor: ['#6eb544', '#e87e1a', '#ff9800', '#2c3e50', '#dc3545'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                cutout: '75%',
                plugins: { legend: { display: false } },
                responsive: true,
                maintainAspectRatio: false
            }
        });

        var mixCtx = document.getElementById('businessMixChart').getContext('2d');
        var businessMixChart = new Chart(mixCtx, {
            type: 'pie',
            data: {
                labels: ['Direct', 'Level'],
                datasets: [{
                    data: [parseFloat("@ViewBag.TotalDirectBusiness".replace(/,/g, '')), parseFloat("@ViewBag.TotalLevelBusienss".replace(/,/g, ''))],
                    backgroundColor: ['#e87e1a', '#6eb544'],
                    borderWidth: 0
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                responsive: true,
                maintainAspectRatio: false
            }
        });

        var trendCtx = document.getElementById('businessTrendChart').getContext('2d');
        var businessTrendChart = new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                datasets: [{
                    label: 'Business Growth',
                    data: [0, parseFloat("@ViewBag.TotalBusiness".replace(/,/g, '')) * 0.3, parseFloat("@ViewBag.TotalBusiness".replace(/,/g, '')) * 0.7, parseFloat("@ViewBag.TotalBusiness".replace(/,/g, ''))],
                    borderColor: '#e87e1a',
                    backgroundColor: 'rgba(232, 126, 26, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#e87e1a'
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { display: false } },
                    x: { grid: { display: false } }
                },
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // --- Associate Business Full Chart ---
        @{
            var assocData = ViewBag.AssociateBusinessData as System.Data.DataTable;
            var assocLabels = new System.Text.StringBuilder();
            var assocValues = new System.Text.StringBuilder();
            if (assocData != null && assocData.Rows.Count > 0)
            {
                int count = 0;
                foreach (System.Data.DataRow row in assocData.Rows)
                {
                    if (count >= 10) { break; }
                    string name = assocData.Columns.Contains("AssociateName") ? row["AssociateName"].ToString() : (assocData.Columns.Contains("Name") ? row["Name"].ToString() : "N/A");
                    if (name.Contains("Regal Space")) { name = name.Replace("Regal Space", "Gardenestate Ventures"); }
                    
                    string amtStr = "0";
                    if (assocData.Columns.Contains("Amount")) { amtStr = row["Amount"].ToString(); }
                    else if (assocData.Columns.Contains("TotalBusiness")) { amtStr = row["TotalBusiness"].ToString(); }
                    else if (assocData.Columns.Contains("NetPlotAmount")) { amtStr = row["NetPlotAmount"].ToString(); }

                    assocLabels.Append("'" + name + "',");
                    assocValues.Append(amtStr + ",");
                    count++;
                }
            }
        }

        var assocCtx = document.getElementById('associateBusinessFullChart').getContext('2d');
        var assocChart = new Chart(assocCtx, {
            type: 'bar',
            data: {
                labels: [@Html.Raw(assocLabels.ToString())],
                datasets: [{
                    label: 'Total Business (Rs.)',
                    data: [@assocValues.ToString()],
                    backgroundColor: 'rgba(110, 181, 68, 0.7)',
                    borderColor: '#6eb544',
                    borderWidth: 1,
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Business: Rs. ' + context.raw.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f0f0f0' },
                        ticks: {
                            callback: function(value) {
                                return 'Rs. ' + value.toLocaleString();
                            }
                        }
                    },
                    x: { grid: { display: false } }
                }
            }
        });

        $(".site-link").click(function () {
            var siteId = $(this).data("siteid");
            var siteName = $(this).data("sitename");

            // Update UI immediately
            $("#selected-site-name").text(siteName);
            $(".site-link").removeClass("active");
            $(this).addClass("active");

            // Update Links
            $("#link-available").attr("href", "/Admin/PlotList?Status=A&SiteID=" + siteId);
            $("#link-booked").attr("href", "/Admin/PlotList?Status=B&SiteID=" + siteId);
            $("#link-onhold").attr("href", "/Admin/PlotList?Status=H&SiteID=" + siteId);
            $("#link-registered").attr("href", "/Admin/PlotList?Status=R&SiteID=" + siteId);
            $("#link-cancelled").attr("href", "/Admin/PlotList?Status=C&SiteID=" + siteId);

            // Fetch Data via AJAX
            $.ajax({
                url: "/Handlers/GetPlotStats.ashx",
                type: "GET",
                data: { siteId: siteId },
                success: function (data) {
                    var total = data.TotalPlots > 0 ? data.TotalPlots : 1;

                    // Update Counts
                    $("#count-available").text(data.Available);
                    $("#count-booked").text(data.Booked);
                    $("#count-onhold").text(data.OnHold);
                    $("#count-registered").text(data.Registered);
                    $("#count-cancelled").text(data.Cancelled);

                    // Update Percents
                    var pAvail = Math.round((data.Available * 100) / total);
                    var pBook = Math.round((data.Booked * 100) / total);
                    var pHold = Math.round((data.OnHold * 100) / total);
                    var pReg = Math.round((data.Registered * 100) / total);
                    var pCan = Math.round((data.Cancelled * 100) / total);

                    $("#percent-available").text(pAvail + "%");
                    $("#percent-booked").text(pBook + "%");
                    $("#percent-onhold").text(pHold + "%");
                    $("#percent-registered").text(pReg + "%");
                    $("#percent-cancelled").text(pCan + "%");

                    // Update Progress Bars
                    $("#progress-available").css("width", pAvail + "%");
                    $("#progress-booked").css("width", pBook + "%");
                    $("#progress-onhold").css("width", pHold + "%");
                    $("#progress-registered").css("width", pReg + "%");
                    $("#progress-cancelled").css("width", pCan + "%");

                    // Update Chart
                    plotChart.data.datasets[0].data = [data.Available, data.Booked, data.OnHold, data.Registered, data.Cancelled];
                    plotChart.update();
                },
                error: function () {
                    console.error("Failed to fetch plot stats.");
                }
            });
        });
    });
</script>

