@{
    ViewBag.Title = "Plot Enquiry List";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    var dt = ViewBag.EnquiryList as System.Data.DataTable;
}
<style>
.card-body, .card-block {
    background: transparent !important;
    padding: 0px !important;
    margin: 0 !important;
    box-shadow: none !important;
}
.table-responsive {
    background: #fff !important;
    border-radius: var(--border-radius);
    padding: 15px !important;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02) !important;
    margin-top: 0px;
    margin-bottom: 0px;
    overflow-x: scroll !important;
    overflow-y: hidden !important;
    display: block !important;
    width: 100% !important;
    scrollbar-width: auto;
    scrollbar-color: #004191 #f8fafc;
}
.btn {
    padding: 10px !important;
    font-weight: 600 !important;
    border-radius: var(--input-radius) !important;
    transition: var(--transition) !important;
    text-transform: capitalize !important;
    letter-spacing: 0.3px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    border: none !important;
}
.table tbody td {
    padding: 12px 8px !important;
    vertical-align: middle !important;
    color: #2d3748 !important;
    border-bottom: 1px solid #edf2f7 !important;
    font-size: 0.9rem !important;
}
</style>
<div class="container-fluid">
    <!-- Page Title -->
    <div class="page-title-box mt-3">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h4 class="page-title font-weight-bold text-dark mb-0">
                    <i class="fas fa-headset text-primary mr-2"></i> Plot Enquiries & Lead Requests
                </h4>
                <p class="text-muted mb-0 small">Manage and follow up on customer leads submitted from Plot Availability layout map.</p>
            </div>
        </div>
    </div>

    <!-- Enquiry Table Card -->
    <div class="card shadow-sm border-0 mt-3" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-primary text-white font-weight-bold py-3">
            <i class="fas fa-list-ul mr-2"></i> Customer Enquiries List (@(dt != null ? dt.Rows.Count : 0) Total Leads)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle" id="enquiryTable">
                    <thead class="bg-light text-uppercase small font-weight-bold text-secondary">
                        <tr>
                            <th class="py-3 px-3">#</th>
                            <th class="py-3">Enquiry Date</th>
                            <th class="py-3">Plot Details</th>
                            <th class="py-3">Customer Name</th>
                            <th class="py-3">Mobile Number</th>
                            <th class="py-3">Questions / Message</th>
                            <th class="py-3 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dt != null && dt.Rows.Count > 0)
                        {
                            int i = 1;
                            foreach (System.Data.DataRow row in dt.Rows)
                            {
                                string id = row["PK_EnquiryID"].ToString();
                                string mobile = row["Mobile"].ToString();
                                string name = row["Name"].ToString();
                                string plotNo = row["PlotNumber"].ToString();
                                string site = row["SiteName"].ToString();
                                string block = row["BlockName"].ToString();
                                string msg = row["Message"].ToString();
                                string dateStr = Convert.ToDateTime(row["EnquiryDate"]).ToString("dd MMM yyyy, hh:mm tt");

                                <tr id="row_@id">
                                    <td class="px-3 font-weight-bold">@i</td>
                                    <td>
                                        <i class="far fa-clock text-muted mr-1"></i> @dateStr
                                    </td>
                                    <td>
                                        <span class="badge badge-primary px-2 py-1 font-weight-bold">Plot @plotNo</span>
                                        <div class="small text-muted font-weight-bold mt-1">@site (@block)</div>
                                    </td>
                                    <td class="font-weight-bold text-dark">
                                        <i class="fas fa-user-circle text-primary mr-1"></i> @name
                                    </td>
                                    <td>
                                        <a href="tel:@mobile" class="font-weight-bold text-primary">
                                            <i class="fas fa-phone-alt mr-1"></i> @mobile
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-secondary small font-italic">@(string.IsNullOrEmpty(msg) ? "No message provided" : msg)</span>
                                    </td>
                                    <td class="text-center">
                                        <a href="https://wa.me/91@(mobile)?text=Hello%20@(name),%20thank%20you%20for%20inquiring%20about%20Plot%20@(plotNo)%20in%20@(site)." target="_blank" class="btn btn-sm btn-success px-2 py-1 shadow-sm font-weight-bold mr-1" style="border-radius: 6px;">
                                            <i class="fab fa-whatsapp mr-1"></i> WhatsApp
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger px-2 py-1 shadow-sm font-weight-bold" onclick="deleteEnquiry(@id)" style="border-radius: 6px;">
                                            <i class="fas fa-trash-alt mr-1"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 opacity-50"></i>
                                    <h5>No Enquiries Found</h5>
                                    <p class="mb-0">When customers submit enquiries on Plot Availability map, they will appear here.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteEnquiry(id) {
        if (!confirm('Are you sure you want to delete this enquiry lead?')) return;

        $.ajax({
            url: '/Admin/DeleteEnquiryAjax',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res && res.Result == "1") {
                    $('#row_' + id).fadeOut(400, function () { $(this).remove(); });
                } else {
                    alert(res && res.Message ? res.Message : 'Error deleting enquiry');
                }
            },
            error: function () {
                alert('Error processing request.');
            }
        });
    }
</script>
