<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <title>@ViewBag.Title - GARDENESTATE VENTURES</title>

    <!-- Core & Vendor CSS -->
    <link rel="stylesheet" href="~/plugins/morris/morris.css">
    <link href="~/plugins/datatables/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/plugins/datatables/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/plugins/datatables/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/css/metismenu.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/css/icons.css" rel="stylesheet" type="text/css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/AutoFill/jquery-ui.css" rel="stylesheet" />

    <!-- Premium Admin Theme CSS -->
    <link href="~/assets/css/style.css" rel="stylesheet" />
    <link href="~/assets/css/premium-sidebar.css" rel="stylesheet" />
    <link href="~/assets/css/premium-content.css" rel="stylesheet" />

    <style>
        #divload {
            width: 100%;
            height: 100%;
            position: absolute;
            z-index: 9999;
            background: url("https://thumbs.gfycat.com/LameDifferentBalloonfish-small.gif") no-repeat center center rgba(0,0,0,0.25);
        }
        .errortext {
            border: 1px solid red !important;
        }
        .dataTables_wrapper {
            padding-top: 10px;
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <!-- Sidebar -->
        <div class="sidebar">
            <a href="/Customer/DashBoard" class="sidebar-header">
                <img src="/files/assets/images/logo.png" alt="GARDENESTATE VENTURES">
                <div class="brand-details">
                    <span class="brand-name">GARDENESTATE</span>
                    <span class="brand-subtitle" style="color: #FFFFFE;">Customer Portal</span>
                </div>
            </a>

            <div class="sidebar-menu">
                <ul id="side-menu">
                    <!-- Dashboard -->
                    <li>
                        <a href="/Customer/DashBoard">
                            <i class="fas fa-th-large"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <!-- Profile Submenu -->
                    <li class="has-submenu">
                        <a href="javascript:void(0);">
                            <i class="fas fa-user-circle"></i>
                            <span>My Profile</span>
                            <i class="fas fa-chevron-down arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="/Customer/UpdateProfile">Update Profile</a></li>
                            <li><a href="/Customer/ChangePassword">Change Password</a></li>
                        </ul>
                    </li>

                    <!-- Bookings & Reports Submenu -->
                    <li class="has-submenu">
                        <a href="javascript:void(0);">
                            <i class="fas fa-building"></i>
                            <span>My Bookings</span>
                            <i class="fas fa-chevron-down arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="/Customer/BookingList">Booking Details</a></li>
                            <li><a href="/Customer/DueInstallmentReport">Due Installments</a></li>
                            <li><a href="/Customer/PlotAvailbilty">Plot Availability</a></li>
                        </ul>
                    </li>
                </ul>
            </div>

            <div class="sidebar-footer">
                <img src="/files/assets/images/user.png" alt="Customer">
                <div class="user-info">
                    <span class="user-name">@(Session["FullName"] != null ? Session["FullName"].ToString() : "Valued Customer")</span>
                    <span class="user-role">ID: @(Session["LoginId"] != null ? Session["LoginId"].ToString() : "")</span>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <div class="loader" id="divload"></div>

            <header class="content-header">
                <div class="header-left">
                    <button id="sidebarToggle" class="btn-toggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="breadcrumb-container">
                        Home / <span class="active">@ViewBag.Title</span>
                    </div>
                </div>

                <div class="header-tools">
                    <div class="header-icons">
                        <div class="dropdown notification-list nav-pro-img">
                            <a class="dropdown-toggle nav-link arrow-none nav-user" data-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                                <i class="fas fa-user-cog"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right profile-dropdown">
                                <a class="dropdown-item" href="/Customer/UpdateProfile"><i class="mdi mdi-account-circle"></i> Profile</a>
                                <a class="dropdown-item" href="/Customer/ChangePassword"><i class="mdi mdi-key"></i> Change Password</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="/Home/Login"><i class="mdi mdi-power text-danger"></i> Logout</a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-body">
                @RenderBody()
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12 text-center text-muted small">
                            &copy; @DateTime.Now.Year GARDENESTATE VENTURES. All Rights Reserved.
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/Autofill/jquery-2.1.3.js"></script>
    <script src="~/Autofill/jquery-ui.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/jquery.slimscroll.js"></script>
    <script src="~/assets/js/waves.min.js"></script>

    <script src="~/plugins/morris/morris.min.js"></script>
    <script src="~/plugins/raphael/raphael.min.js"></script>

    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/dataTables.buttons.min.js"></script>
    <script src="~/plugins/datatables/buttons.bootstrap4.min.js"></script>
    <script src="~/plugins/datatables/jszip.min.js"></script>
    <script src="~/plugins/datatables/pdfmake.min.js"></script>
    <script src="~/plugins/datatables/vfs_fonts.js"></script>
    <script src="~/plugins/datatables/buttons.html5.min.js"></script>
    <script src="~/plugins/datatables/buttons.print.min.js"></script>
    <script src="~/plugins/datatables/buttons.colVis.min.js"></script>
    <script src="~/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/plugins/datatables/responsive.bootstrap4.min.js"></script>

    <script src="~/assets/js/app.js"></script>

    <script>
        $(document).ready(function () {
            $("#divload").css({ 'display': 'none' });

            // Sidebar toggle logic
            $('#sidebarToggle').on('click', function () {
                $('body').toggleClass('collapsed-sidebar');
            });

            // Submenu toggle logic
            $('.has-submenu > a').on('click', function (e) {
                e.preventDefault();
                var $parent = $(this).parent('.has-submenu');
                $parent.toggleClass('open');
                $parent.siblings('.has-submenu').removeClass('open');
            });
        });
    </script>
</body>
</html>
