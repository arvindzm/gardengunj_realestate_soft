@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "Booking Details";
    Layout = "~/Views/Shared/CustomerLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-list-alt mr-2"></i>My Booking Details</h5>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm("BookingList", "Customer", FormMethod.Post, new { @id = "form1" }))
                {
                    <div class="row mb-3">
                        <div class="col-md-3 mb-2">
                            <label class="font-weight-bold">Site</label>
                            @Html.DropDownListFor(m => m.SiteID, new SelectList(ViewBag.ddlSite ?? new List<SelectListItem>(), "Value", "Text"), new { @class = "form-control" })
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="font-weight-bold">From Date</label>
                            @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @placeholder = "From Date", @readonly = "readonly", @id = "FromDate" })
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="font-weight-bold">To Date</label>
                            @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control", @placeholder = "To Date", @readonly = "readonly", @id = "ToDate" })
                        </div>
                        <div class="col-md-3 mb-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100" id="btnSearch">
                                <i class="fas fa-search mr-2"></i>Filter
                            </button>
                        </div>
                    </div>
                }

                <div class="table-responsive mt-4">
                    <table id="customerBookingTable" class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>Booking No</th>
                                <th>Site Name</th>
                                <th>Sector</th>
                                <th>Block</th>
                                <th>Plot No</th>
                                <th>Booking Date</th>
                                <th>Plot Amount</th>
                                <th>Booking Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.lstPlot != null && Model.lstPlot.Count > 0)
                            {
                                int i = 1;
                                foreach (var item in Model.lstPlot)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td><span class="badge badge-pill badge-primary">@item.PK_BookingId</span></td>
                                        <td>@item.SiteName</td>
                                        <td>@item.SectorName</td>
                                        <td>@item.BlockName</td>
                                        <td><span class="font-weight-bold text-dark">@item.PlotNumber</span></td>
                                        <td>@item.BookingDate</td>
                                        <td>Rs. @item.PlotAmount</td>
                                        <td>Rs. @item.BookingAmount</td>
                                        <td>
                                            @if (item.BookingStatus == "Approved" || item.BookingStatus == "Allotted" || item.BookingStatus == "Registered")
                                            {
                                                <span class="badge badge-success px-2 py-1">@item.BookingStatus</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning px-2 py-1">@(string.IsNullOrEmpty(item.BookingStatus) ? "Active" : item.BookingStatus)</span>
                                            }
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-4">No booking records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script>
    $(document).ready(function () {
        if ($('#customerBookingTable tbody tr').length > 0 && !$('#customerBookingTable tbody tr td').hasClass('dataTables_empty')) {
            $('#customerBookingTable').DataTable({
                responsive: true,
                dom: 'Bfrtip',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
            });
        }
    });
</script>
